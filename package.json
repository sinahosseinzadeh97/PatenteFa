{
  "name": "patente-fa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply patente-fa-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply patente-fa-db --remote",
    "db:schema:local": "wrangler d1 execute patente-fa-db --local --file ./src/db/schema.sql",
    "import": "tsx scripts/import-question-bank.ts",
    "migrate:signs": "tsx scripts/migrate-signs-to-r2.ts"
  },
  "dependencies": {
    "hono": "^4.7.11"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "wrangler": "^4.25.0"
  }
}
