# Copy this file to .dev.vars and fill in real values.
# .dev.vars is gitignored — never commit it.

TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token-here
TELEGRAM_WEBHOOK_SECRET=some-random-secret-string
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Image (sign/diagram) questions only — mini misreads road signs. Default: gpt-4o
OPENAI_VISION_MODEL=gpt-4o
ALLOWED_TELEGRAM_USER_IDS=123456789,987654321
# Exactly one account can access admin APIs and receive the admin UI.
# If omitted, the first ALLOWED_TELEGRAM_USER_IDS entry is used for compatibility.
PRIMARY_ADMIN_TELEGRAM_USER_ID=123456789
LOG_CHANNEL_ID=-1001234567890
MINI_APP_URL=https://your-worker.your-account.workers.dev
DEFAULT_TIMEZONE=Europe/Rome
